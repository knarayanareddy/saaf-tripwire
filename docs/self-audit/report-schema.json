{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SAAF Tripwire self-audit findings",
  "type": "object",
  "required": ["audit", "records"],
  "properties": {
    "audit": {
      "type": "object",
      "required": ["target", "commit", "method", "reproduce"],
      "additionalProperties": true,
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 7},
        "method": {"type": "string", "minLength": 10},
        "reproduce": {"type": "string", "minLength": 1}
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/record"}
    }
  },
  "definitions": {
    "record": {
      "type": "object",
      "required": ["id", "verdict", "class", "component", "summary"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "pattern": "^TW-[ARN][0-9]+$"},
        "verdict": {"enum": ["confirmed", "rejected", "needs_validation"]},
        "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
        "class": {
          "enum": ["ai-and-llm", "web-protocol-and-auth", "client-side", "data-isolation",
                   "resource-exhaustion", "supply-chain-and-release", "business-logic", "quality"]
        },
        "component": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 12},
        "trace": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "line", "note"],
            "properties": {
              "file": {"type": "string"},
              "line": {"type": "integer", "minimum": 1},
              "note": {"type": "string"}
            }
          }
        },
        "probe": {
          "type": "object",
          "required": ["command", "expectation"],
          "properties": {
            "command": {"type": "string", "minLength": 1},
            "expectation": {"type": "string", "minLength": 1}
          }
        },
        "observedBefore": {"type": "string"},
        "observedAfter": {"type": "string"},
        "fix": {"type": "string"},
        "status": {"enum": ["fixed", "mitigated", "open"]},
        "refutation": {"type": "string"},
        "unresolved": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"verdict": {"const": "confirmed"}}, "required": ["verdict"]},
          "then": {"required": ["severity", "trace", "probe", "observedBefore", "observedAfter", "fix", "status"]}
        },
        {
          "if": {"properties": {"verdict": {"const": "rejected"}}, "required": ["verdict"]},
          "then": {"required": ["refutation"]}
        },
        {
          "if": {"properties": {"verdict": {"const": "needs_validation"}}, "required": ["verdict"]},
          "then": {"required": ["unresolved"], "not": {"required": ["severity"]}}
        }
      ]
    }
  }
}
